# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# terraform: state and providers stay out of git; .terraform.lock.hcl is committed
.terraform/
*.tfstate
*.tfstate.*
crash.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# impeccable: installed tooling and local review files
/.claude/skills/impeccable/
/.claude/agents/impeccable-*.md
/.claude/settings.local.json
/.impeccable/config.local.json
/.impeccable/hook.cache.json
/.impeccable/live/
/.impeccable/mocks/
/.impeccable/questions/
/.impeccable/review/

# Owner photos not used on the site; consent for the people in them is still [TODO]
unused-photos/
