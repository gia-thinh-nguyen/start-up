# Copy to .env.local for local development, and add the same names in Vercel → Settings → Environment Variables.
# Never commit real values.

# Contact form email, sent through the business's Zoho mailbox (SMTP; needs a paid Zoho plan).
# SMTP_PASS is a Zoho app-specific password (Account → Security → App Passwords), never the login password.
SMTP_HOST=smtp.zoho.com.au
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where enquiries arrive. The from address must be SMTP_USER or one of its Zoho aliases (empty uses SMTP_USER).
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile). Left empty in development, Cloudflare's test keys are used.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Booking and the travel fee. See docs/tech-stack.md.
# Cal.com → Settings → Developer → API keys, and the secret of the "Booking created" webhook.
CAL_API_KEY=
CAL_WEBHOOK_SECRET=
# Stripe → Developers → API keys (sk_test_… until launch), and the signing secret of the webhook for checkout.session.expired.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: the site's public address, for Stripe's return links. Vercel's own address is used when empty.
SITE_URL=
