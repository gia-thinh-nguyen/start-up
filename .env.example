# Copy to .env.local for local development, and add the same names in Vercel → Settings → Environment Variables.
# Never commit real values.

# Contact form email (resend.com). The from address must be on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile). Left empty in development, Cloudflare's test keys are used.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
